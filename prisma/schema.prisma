// Prisma + SQLite. Tiền lưu dạng số nguyên VND (đồng).
// SQLite không hỗ trợ enum/array => dùng String + validate ở tầng app (zod).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id             String         @id @default(cuid())
  name           String
  nameNormalized String         @default("") // bỏ dấu + lowercase, dùng để tìm kiếm không phân biệt dấu
  slug           String         @unique
  description    String
  priceVnd       Int
  salePriceVnd   Int?
  stock          Int            @default(0)
  sizes          String         @default("[]") // JSON array các size, vd ["S","M","L"]
  colors         String         @default("[]") // JSON array tên màu, vd ["Đen","Trắng"]
  isActive       Boolean        @default(true)
  isNew          Boolean        @default(false)
  isFeatured     Boolean        @default(false)
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  orderItems     OrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([nameNormalized])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0)

  @@index([productId])
}

model Order {
  id             String      @id @default(cuid())
  code           String      @unique
  customerName   String
  phone          String
  email          String?
  address        String
  note           String?
  paymentMethod  String // "cod" | "bank_transfer"
  status         String      @default("pending") // pending|confirmed|shipping|completed|cancelled
  subtotalVnd    Int
  shippingFeeVnd Int
  totalVnd       Int
  items          OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  productSlug  String
  imageUrl     String?
  unitPriceVnd Int
  quantity     Int
  size         String?
  color        String?

  @@index([orderId])
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  contentMd   String
  coverUrl    String
  publishedAt DateTime  @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
