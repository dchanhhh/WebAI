# Cơ sở dữ liệu (Prisma + SQLite)
DATABASE_URL="file:./dev.db"

# Phiên đăng nhập admin — chuỗi ngẫu nhiên >= 32 ký tự
SESSION_SECRET="doi-chuoi-nay-thanh-mot-gia-tri-ngau-nhien-dai"

# Tài khoản admin.
# LƯU Ý: hash bcrypt chứa ký tự `$` sẽ bị Next.js (dotenv-expand) bóc mất, nên
# lưu hash ở dạng BASE64 qua ADMIN_PASSWORD_HASH_B64.
# Tạo giá trị:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync(process.argv[1],10)).toString('base64'))" "MatKhauCuaBan"
ADMIN_EMAIL="admin@webai.local"
ADMIN_PASSWORD_HASH_B64="thay_bang_gia_tri_base64"
# (Tuỳ chọn) hoặc dùng hash thô nhưng phải escape từng dấu $ thành \$:
# ADMIN_PASSWORD_HASH="\$2a\$10\$..."

# Thông tin nhận chuyển khoản (hiển thị ở trang đặt hàng thành công)
BANK_NAME="Ngân hàng TMCP Ngoại thương Việt Nam (Vietcombank)"
BANK_ACCOUNT_NAME="CONG TY TNHH WEBAI"
BANK_ACCOUNT_NUMBER="0123456789"
BANK_BRANCH="Chi nhánh TP. Hồ Chí Minh"

# Phí vận chuyển mặc định (VND, số nguyên đồng)
SHIPPING_FEE_VND="30000"
# Miễn phí ship khi tạm tính >= ngưỡng này (VND). Để 0 nếu không áp dụng.
FREE_SHIPPING_THRESHOLD_VND="500000"
